{
  "_comment": "Executables the hub can find. 'find' entries are tried in order: a bare name is looked up on PATH, 'flatpak:<app-id>' runs through flatpak, anything else is a path (~ and %VAR% expanded). Users can override any program with an explicit path in settings.json -> programs.<id>. Paths are candidates, not guarantees.",
  "retroarch": {
    "name": "RetroArch",
    "homepage": "https://www.retroarch.com/",
    "license": "GPL-3.0",
    "version_args": ["--version"],
    "find": {
      "linux": ["retroarch", "flatpak:org.libretro.RetroArch"],
      "windows": ["%APPDATA%\\EmuDeck\\Emulators\\RetroArch\\retroarch.exe", "C:\\RetroArch-Win64\\retroarch.exe", "%PROGRAMFILES%\\RetroArch\\retroarch.exe", "%PROGRAMFILES(X86)%\\Steam\\steamapps\\common\\RetroArch\\retroarch.exe", "retroarch.exe"],
      "darwin": ["/Applications/RetroArch.app/Contents/MacOS/RetroArch"]
    },
    "install_hint": "Install RetroArch from https://www.retroarch.com/?page=platforms (Linux: your package manager or Flathub), then install the needed core from Main Menu > Online Updater > Core Downloader."
  },
  "mgba": {
    "name": "mGBA (standalone)",
    "homepage": "https://mgba.io/",
    "license": "MPL-2.0",
    "version_args": ["--version"],
    "find": {
      "linux": ["mgba-qt", "mgba", "/usr/games/mgba", "flatpak:io.mgba.mGBA"],
      "windows": ["%PROGRAMFILES%\\mGBA\\mGBA.exe", "mGBA.exe"],
      "darwin": ["/Applications/mGBA.app/Contents/MacOS/mGBA"]
    },
    "install_hint": "Download mGBA from https://mgba.io/downloads.html."
  },
