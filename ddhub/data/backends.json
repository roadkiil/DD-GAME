{
  "_comment": "Launch methods. args are argv tokens (never a shell string). Placeholders: {rom} {rom_dir} {rom_stem} {core_path} {appid} {url}. 'requires' lists user-provided files; 'optional': true means the emulator has a built-in fallback. 'tracking': process = wait for the process tree to exit; steam = watch Steam's RunningAppID; manual = hub cannot observe the session (streaming), the user confirms when done. 'features' are only what the backend itself provides - the hub exposes nothing it cannot back. 'local_verified' lists hosts where the DD Hub team actually played something; it is informational only, each user's readiness comes from their own test records.",
  "retroarch-mgba": {
    "name": "RetroArch + mGBA core",
    "kind": "emulated",
    "program": "retroarch",
    "core": "mgba",
    "platforms": [
      "gb",
      "gbc",
      "gba"
    ],
    "args": [
      "-L",
      "{core_path}",
      "{rom}"
    ],
    "fullscreen_args": [
      "-f"
    ],
    "features": {
      "save_states": true,
      "rewind": true,
      "achievements": "RetroAchievements (free account, set in RetroArch)",
      "netplay": false,
      "screenshots": true,
      "local_multiplayer": false
    },
    "tracking": "process"
  },
